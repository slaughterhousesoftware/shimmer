+static void stream_connection_negotiate_version(ChiakiStreamConnection *stream_connection)
+{
+	List versions = { .items = { 12, 20 }, .num_items = 2 };
+	tkproto_TakionMessage msg;
+	memset(&msg, 0, sizeof(msg));
+	msg.type = tkproto_TakionMessage_PayloadType_TAKIONPROTOCOLREQUEST;
+	msg.has_takion_protocol_request = true;
+	msg.takion_protocol_request.supported_takion_versions.arg = &versions;
+	msg.takion_protocol_request.supported_takion_versions.funcs.encode = chiaki_pb_encode_list;
+
+	uint8_t buf[32];
+	pb_ostream_t stream = pb_ostream_from_buffer(buf, sizeof(buf));
+	if(!pb_encode(&stream, tkproto_TakionMessage_fields, &msg))
+	{
+		CHIAKI_LOGE(stream_connection->log, "StreamConnection failed to encode the Takion version request");
+		return;
+	}
+
+	stream_connection->state = STATE_EXPECT_PROTOCOL_ACK;
+	stream_connection->state_finished = false;
+	stream_connection->state_failed = false;
+	stream_connection->protocol_ack_version = 0;
+	ChiakiErrorCode err = chiaki_takion_send_message_data(&stream_connection->takion, 1, 1, buf, stream.bytes_written, NULL);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(stream_connection->log, "StreamConnection failed to send the Takion version request: %s", chiaki_error_string(err));
+		return;
+	}
+	uint64_t start_ms = chiaki_time_now_monotonic_ms();
+	chiaki_cond_timedwait_pred(&stream_connection->state_cond, &stream_connection->state_mutex, PROTOCOL_ACK_TIMEOUT_MS, state_finished_cond_check, stream_connection);
+	uint32_t chosen = stream_connection->state_finished ? stream_connection->protocol_ack_version : 0;
+	stream_connection->state_finished = false;
+	stream_connection->state_failed = false;
+	if(!chosen)
+	{
+		CHIAKI_LOGW(stream_connection->log, "StreamConnection got no Takion version from the console in %llu ms, staying on %u",
+				(unsigned long long)(chiaki_time_now_monotonic_ms() - start_ms), (unsigned int)stream_connection->takion.version);
+		return;
+	}
+	CHIAKI_LOGI(stream_connection->log, "StreamConnection: console chose Takion version %u in %llu ms",
+			(unsigned int)chosen, (unsigned long long)(chiaki_time_now_monotonic_ms() - start_ms));
+	if(chosen != 20)
+		return;
+
+	// From Takion 13 on, BIG/BANG exchange keys on secp521r1.
+	if(chiaki_ecdh_init_p521(&stream_connection->ecdh_p521) != CHIAKI_ERR_SUCCESS)
+	{
+		// The console expects v20 now; v12 would fail as surely as this. Let BIG go out and BANG tell.
+		CHIAKI_LOGE(stream_connection->log, "StreamConnection failed to create a secp521r1 key");
+		return;
+	}
+	stream_connection->ecdh_p521_active = true;
+	chiaki_takion_set_version(&stream_connection->takion, 20);
+}
