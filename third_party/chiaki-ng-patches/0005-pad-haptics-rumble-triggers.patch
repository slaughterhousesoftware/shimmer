-		packet->is_haptics = (v20 ? (*av & 0xf) : *av) == 0x02;
+		// The channel: low nibble on v20 (the high one is something else), the
+		// whole byte before. Pad N's haptics ride channel 2+N.
+		packet->audio_channel = v20 ? (*av & 0xf) : *av;
+		packet->is_haptics = packet->audio_channel >= 0x02 && packet->audio_channel <= 0x05;
+		packet->haptics_pad = packet->is_haptics ? (uint8_t)(packet->audio_channel - 0x02) : 0;
 		shimmer_audio_tag_counts[*av]++;
 		av += 1;
 		av_size -= 1;
