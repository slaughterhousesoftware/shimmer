diff --git a/lib/src/packetstats.c b/lib/src/packetstats.c
index 58ef4c6..25c8963 100644
--- a/lib/src/packetstats.c
+++ b/lib/src/packetstats.c
@@ -50,9 +50,15 @@ CHIAKI_EXPORT void chiaki_packet_stats_push_generation(ChiakiPacketStats *stats,
 
 CHIAKI_EXPORT void chiaki_packet_stats_push_seq(ChiakiPacketStats *stats, ChiakiSeqNum16 seq_num)
 {
+	// Shimmer: locked like push_generation. chiaki_packet_stats_get reads and
+	// resets these on the congestion-control thread under the mutex; unlocked
+	// updates from the takion thread raced it (ThreadSanitizer) and could skew
+	// the loss figure the bitrate adaptation runs on.
+	chiaki_mutex_lock(&stats->mutex);
 	stats->seq_received++;
 	if(chiaki_seq_num_16_gt(seq_num, stats->seq_max))
 		stats->seq_max = seq_num;
+	chiaki_mutex_unlock(&stats->mutex);
 }
 
 CHIAKI_EXPORT void chiaki_packet_stats_get(ChiakiPacketStats *stats, bool reset, uint64_t *received, uint64_t *lost)
diff --git a/lib/src/takionsendbuffer.c b/lib/src/takionsendbuffer.c
index 0d7f756..90334cf 100644
--- a/lib/src/takionsendbuffer.c
+++ b/lib/src/takionsendbuffer.c
@@ -67,8 +67,12 @@ error_packets:
 
 CHIAKI_EXPORT void chiaki_takion_send_buffer_fini(ChiakiTakionSendBuffer *send_buffer)
 {
+	// Shimmer: under the mutex the send thread's wait predicate reads it with
+	// (ThreadSanitizer saw the unlocked write race that read).
+	chiaki_mutex_lock(&send_buffer->mutex);
 	send_buffer->should_stop = true;
 	ChiakiErrorCode err = chiaki_cond_signal(&send_buffer->cond);
+	chiaki_mutex_unlock(&send_buffer->mutex);
 	assert(err == CHIAKI_ERR_SUCCESS);
 	err = chiaki_thread_join(&send_buffer->thread, NULL);
 	assert(err == CHIAKI_ERR_SUCCESS);
