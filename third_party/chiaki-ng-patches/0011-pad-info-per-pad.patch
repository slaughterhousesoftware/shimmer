+/**
+ * Shimmer: one pad info message (CHIAKI_TAKION_MESSAGE_DATA_TYPE_PAD_INFO), as
+ * chiaki-ng-core reads it. Each message is for one pad - `index`, the low
+ * nibble of the selector - and only pad 0's says anything about player 1.
+ */
+typedef struct chiaki_pad_info_t
+{
+	uint8_t index; // the pad the message is for (0-3)
+	uint8_t led[3];
+	bool motion_reset; // pad 0 asked to re-centre motion (byte == 1)
+	bool user_valid; // a user holds the pad (the 0x11 layout's [7], the 0x19 layout's [15])
+	uint8_t haptic_intensity;
+	uint8_t trigger_intensity;
+	uint16_t feedback_seq_num; // 0x19 layout only
+} ChiakiPadInfo;
+
+/** Shimmer: parse a pad info payload (0x19/0x1a with the 8-byte prefix, or 0x11/0x12); false for other sizes. */
+CHIAKI_EXPORT bool chiaki_pad_info_parse(const uint8_t *buf, size_t buf_size, ChiakiPadInfo *info);
+
 CHIAKI_EXPORT ChiakiErrorCode chiaki_stream_connection_send_pad_connection(ChiakiStreamConnection *stream_connection, uint8_t pad, bool connected);
 CHIAKI_EXPORT ChiakiErrorCode chiaki_stream_connection_init(ChiakiStreamConnection *stream_connection, ChiakiSession *session, double packet_loss_max);
 CHIAKI_EXPORT void chiaki_stream_connection_fini(ChiakiStreamConnection *stream_connection);
