+CHIAKI_EXPORT bool chiaki_pad_info_parse(const uint8_t *buf, size_t buf_size, ChiakiPadInfo *info)
+{
+	memset(info, 0, sizeof(*info));
+	size_t row;
+	switch(buf_size)
+	{
+		case 0x1a: // Takion 20 may append a byte
+		case 0x19: // 8-byte prefix, then the 0x11 layout
+			info->feedback_seq_num = ntohs(*(chiaki_unaligned_uint16_t *)(buf));
+			row = 8;
+			break;
+		case 0x12:
+		case 0x11:
+			row = 0;
+			break;
+		default:
+			return false;
+	}
+	// low nibble: the high one (Takion 16+) isn't the index
+	info->index = buf[row] & 0x0f;
+	memcpy(info->led, buf + row + 1, 3);
+	// a reset is 1 (Sony's app; P5M), and only pad 0's (chiaki-ng-core)
+	info->motion_reset = info->index == 0 && buf[row + 4] == 1;
+	info->user_valid = buf[row + 7] != 0;
+	info->haptic_intensity = buf[row + 12];
+	info->trigger_intensity = buf[row + 13];
+	return true;
+}
