 	{
 		if(setsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&size, sizeof(size)) == 0)
diff -ruN a/lib/src/videoreceiver.c b/lib/src/videoreceiver.c
--- a/lib/src/videoreceiver.c
+++ b/lib/src/videoreceiver.c
@@ -9,6 +9,10 @@
 // While waiting for a requested IDR frame, request it again this often, in case the request
 // or the IDR frame itself was lost; otherwise the picture would stay frozen
 #define VIDEO_IDR_RETRY_INTERVAL_MS 1000
+// Shimmer (as chiaki-ng-core's refusals_before_idr): this many frames in a row
+// without their reference - the picture frozen ~170 ms at 60 fps - ask for an
+// IDR frame rather than wait out the app's 2 s watchdog.
+#define VIDEO_REFUSALS_BEFORE_IDR 10
 
 static ChiakiErrorCode chiaki_video_receiver_flush_frame(ChiakiVideoReceiver *video_receiver);
 
@@ -60,6 +64,7 @@
 	chiaki_mutex_init(&video_receiver->waiting_for_idr_mutex, false);
 	video_receiver->waiting_for_idr = false;
 	video_receiver->idr_request_last_ms = 0;
+	video_receiver->frames_refused = 0;
 	chiaki_mutex_init(&video_receiver->frames_lost_mutex, false);
 }
 
@@ -346,7 +351,22 @@
 	video_receiver->frame_index_prev = video_receiver->frame_index_cur;
 
 	if(succ)
+	{
 		video_receiver->frame_index_prev_complete = video_receiver->frame_index_cur;
+		video_receiver->frames_refused = 0;
+	}
+	else if(++video_receiver->frames_refused >= VIDEO_REFUSALS_BEFORE_IDR
+		&& !chiaki_video_receiver_get_waiting_for_idr(video_receiver))
+	{
+		ChiakiErrorCode err = stream_connection_send_idr_request(&video_receiver->session->stream_connection);
+		if(err == CHIAKI_ERR_SUCCESS)
+		{
+			chiaki_video_receiver_set_waiting_for_idr(video_receiver, true);
+			CHIAKI_LOGI(video_receiver->log, "%u frames in a row without their reference, requested an IDR frame",
+					video_receiver->frames_refused);
+		}
+		video_receiver->frames_refused = 0;
+	}
 
 	return CHIAKI_ERR_SUCCESS;
 }
