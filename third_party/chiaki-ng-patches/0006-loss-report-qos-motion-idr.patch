 // Shimmer: the largest receive buffer the kernel grants, from
 // TAKION_SOCKET_RCVBUF down to the advertised window.
+// Shimmer (as P5M): interactive video - the Wi-Fi driver and the router
+// queue our input and acks ahead of bulk traffic (WMM video, DSCP AF41).
+static void takion_set_qos(ChiakiTakion *takion)
+{
+#if defined(__APPLE__)
+	int service = NET_SERVICE_TYPE_VI;
+	setsockopt(takion->sock, SOL_SOCKET, SO_NET_SERVICE_TYPE, &service, sizeof(service));
+#endif
+#if !defined(_WIN32)
+	int tos = 34 << 2;
+	setsockopt(takion->sock, IPPROTO_IP, IP_TOS, (const CHIAKI_SOCKET_BUF_TYPE)&tos, sizeof(tos));
+#endif
+}
+
 static int takion_set_rcvbuf(ChiakiTakion *takion)
 {
+	takion_set_qos(takion);
