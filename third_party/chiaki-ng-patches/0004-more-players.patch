+CHIAKI_EXPORT ChiakiErrorCode chiaki_feedback_sender_set_controller_state_pad(ChiakiFeedbackSender *feedback_sender, uint8_t pad, ChiakiControllerState *state)
+{
+	if(pad == 0)
+		return chiaki_feedback_sender_set_controller_state(feedback_sender, state);
+	if(pad >= CHIAKI_FEEDBACK_SENDER_PADS)
+		return CHIAKI_ERR_INVALID_DATA;
+	ChiakiErrorCode err = chiaki_mutex_lock(&feedback_sender->state_mutex);
+	if(err != CHIAKI_ERR_SUCCESS)
+		return err;
+	if(!feedback_sender->pad_active[pad])
+	{
+		// the pad joins: a presence event first, then its state from idle
+		feedback_sender->pad_active[pad] = true;
+		chiaki_controller_state_set_idle(&feedback_sender->pad_history_prev[pad]);
+		chiaki_controller_state_set_idle(&feedback_sender->pad_state_prev[pad]);
+		ChiakiFeedbackHistoryEvent event;
+		chiaki_feedback_history_event_set_presence(&event, pad, true);
+		chiaki_feedback_history_buffer_push(&feedback_sender->history_buf, &event);
+		feedback_sender_history_event_pushed(feedback_sender);
+		feedback_sender->pad_changed[pad] = true;
+	}
+	else if(chiaki_controller_state_equals(&feedback_sender->pad_state[pad], state))
+	{
+		chiaki_mutex_unlock(&feedback_sender->state_mutex);
+		return CHIAKI_ERR_SUCCESS;
+	}
+	feedback_sender->pad_state[pad] = *state;
+	chiaki_feedback_history_buffer_record_state_pad(&feedback_sender->history_buf, feedback_sender->log,
+			&feedback_sender->pad_history_prev[pad], state, pad, feedback_sender_history_event_pushed, feedback_sender);
+	feedback_sender->pad_history_prev[pad] = *state;
+	feedback_sender->pad_changed[pad] = true;
+	chiaki_mutex_unlock(&feedback_sender->state_mutex);
+	chiaki_cond_signal(&feedback_sender->state_cond);
+	return CHIAKI_ERR_SUCCESS;
+}
+
+CHIAKI_EXPORT ChiakiErrorCode chiaki_feedback_sender_remove_pad(ChiakiFeedbackSender *feedback_sender, uint8_t pad)
+{
+	if(pad == 0 || pad >= CHIAKI_FEEDBACK_SENDER_PADS)
+		return CHIAKI_ERR_INVALID_DATA;
+	ChiakiErrorCode err = chiaki_mutex_lock(&feedback_sender->state_mutex);
+	if(err != CHIAKI_ERR_SUCCESS)
+		return err;
+	if(feedback_sender->pad_active[pad])
+	{
+		// release whatever it held, then say it left
+		ChiakiControllerState idle;
+		chiaki_controller_state_set_idle(&idle);
+		chiaki_feedback_history_buffer_record_state_pad(&feedback_sender->history_buf, feedback_sender->log,
+				&feedback_sender->pad_history_prev[pad], &idle, pad, feedback_sender_history_event_pushed, feedback_sender);
+		ChiakiFeedbackHistoryEvent event;
+		chiaki_feedback_history_event_set_presence(&event, pad, false);
+		chiaki_feedback_history_buffer_push(&feedback_sender->history_buf, &event);
+		feedback_sender_history_event_pushed(feedback_sender);
+		feedback_sender->pad_active[pad] = false;
+		feedback_sender->pad_changed[pad] = false;
+		feedback_sender->pad_state[pad] = idle;
+		feedback_sender->pad_history_prev[pad] = idle;
+	}
+	chiaki_mutex_unlock(&feedback_sender->state_mutex);
+	chiaki_cond_signal(&feedback_sender->state_cond);
+	return CHIAKI_ERR_SUCCESS;
+}
