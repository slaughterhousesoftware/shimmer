+CHIAKI_EXPORT ChiakiErrorCode chiaki_session_set_controller_state_pad(ChiakiSession *session, uint8_t pad, ChiakiControllerState *state)
+{
+	if(pad == 0)
+		return chiaki_session_set_controller_state(session, state);
+	ChiakiErrorCode err = chiaki_mutex_lock(&session->stream_connection.feedback_sender_mutex);
+	if(err != CHIAKI_ERR_SUCCESS)
+		return err;
+	if(session->stream_connection.feedback_sender_active)
+		err = chiaki_feedback_sender_set_controller_state_pad(&session->stream_connection.feedback_sender, pad, state);
+	chiaki_mutex_unlock(&session->stream_connection.feedback_sender_mutex);
+	return err;
+}
+
+CHIAKI_EXPORT ChiakiErrorCode chiaki_session_join_user(ChiakiSession *session, uint8_t pad, uint64_t account_id)
+{
+	uint8_t payload[0x10] = { 0 };
+	for(size_t i = 0; i < 8; i++)
+		payload[i] = (uint8_t)(account_id >> (8 * i));
+	payload[8] = pad;
+	payload[9] = 3; // DualShock 4 / DualSense
+	return chiaki_ctrl_send_message(&session->ctrl, 0x68, payload, sizeof(payload));
+}
+
+CHIAKI_EXPORT ChiakiErrorCode chiaki_session_answer_user_passcode(ChiakiSession *session, uint8_t pad, const char *passcode)
+{
+	if(!passcode || strlen(passcode) != 4)
+		return CHIAKI_ERR_INVALID_DATA;
+	uint8_t payload[8] = { pad, (uint8_t)passcode[0], (uint8_t)passcode[1], (uint8_t)passcode[2], (uint8_t)passcode[3], 0, 0, 0 }; // 8 bytes, as Sony and PXPlay
+	return chiaki_ctrl_send_message(&session->ctrl, 0x8064, payload, sizeof(payload));
+}
+
+CHIAKI_EXPORT ChiakiErrorCode chiaki_session_leave_pad(ChiakiSession *session, uint8_t pad)
+{
+	if(pad == 0)
+		return CHIAKI_ERR_INVALID_DATA;
+	ChiakiErrorCode err = chiaki_mutex_lock(&session->stream_connection.feedback_sender_mutex);
+	if(err != CHIAKI_ERR_SUCCESS)
+		return err;
+	if(session->stream_connection.feedback_sender_active)
+		chiaki_feedback_sender_remove_pad(&session->stream_connection.feedback_sender, pad);
+	chiaki_mutex_unlock(&session->stream_connection.feedback_sender_mutex);
+	uint8_t payload[1] = { pad };
+	return chiaki_ctrl_send_message(&session->ctrl, 0x09, payload, sizeof(payload));
+}
