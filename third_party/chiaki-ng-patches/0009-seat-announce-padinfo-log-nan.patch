 /**
- * Shimmer: pad `pad` (1-3) disconnected, as PXPlay and chiaki-ng-androidtv
- * send it after ctrl 0x09: controller_id set, connected=false, no type.
+ * Shimmer: pad `pad` (1-3) joined or left, on the Takion side (ctrl 0x68 /
+ * 0x09 are the console side). As chiaki-ng-core and chiaki-ng-androidtv:
+ * once the console seats the user (0x8068 status 0) the pad is announced
+ * connected with its type - an extra pad gets no haptics until it is (Remote
+ * Game, on a PS5) - and on leave it is disconnected with the type "not set"
+ * (chiaki-ng-core; androidtv repeats the type).
  */
-CHIAKI_EXPORT ChiakiErrorCode chiaki_stream_connection_send_pad_disconnected(ChiakiStreamConnection *stream_connection, uint8_t pad)
+CHIAKI_EXPORT ChiakiErrorCode chiaki_stream_connection_send_pad_connection(ChiakiStreamConnection *stream_connection, uint8_t pad, bool connected)
 {
 	tkproto_TakionMessage msg;
 	memset(&msg, 0, sizeof(msg));
 	msg.type = tkproto_TakionMessage_PayloadType_CONTROLLERCONNECTION;
 	msg.has_controller_connection_payload = true;
 	msg.controller_connection_payload.has_connected = true;
-	msg.controller_connection_payload.connected = false;
+	msg.controller_connection_payload.connected = connected;
 	msg.controller_connection_payload.has_controller_id = true;
 	msg.controller_connection_payload.controller_id = pad;
-	msg.controller_connection_payload.has_controller_type = false;
+	msg.controller_connection_payload.has_controller_type = true;
+	msg.controller_connection_payload.controller_type = !connected
+		? tkproto_ControllerConnectionPayload_ControllerType_NOTSET
+		: stream_connection->session->connect_info.enable_dualsense
+			? tkproto_ControllerConnectionPayload_ControllerType_DUALSENSE
+			: tkproto_ControllerConnectionPayload_ControllerType_DUALSHOCK4;
 
 	uint8_t buf[256];
 	pb_ostream_t stream = pb_ostream_from_buffer(buf, sizeof(buf));
 	if(!pb_encode(&stream, tkproto_TakionMessage_fields, &msg))
 	{
-		CHIAKI_LOGE(stream_connection->log, "StreamConnection pad disconnect protobuf encoding failed");
+		CHIAKI_LOGE(stream_connection->log, "StreamConnection pad connection protobuf encoding failed");
 		return CHIAKI_ERR_UNKNOWN;
 	}
 	return chiaki_takion_send_message_data(&stream_connection->takion, 1, 1, buf, stream.bytes_written, NULL);
