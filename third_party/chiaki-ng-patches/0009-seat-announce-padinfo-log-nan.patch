diff -ruN a/lib/src/feedback.c b/lib/src/feedback.c
--- a/lib/src/feedback.c
+++ b/lib/src/feedback.c
@@ -23,7 +23,8 @@
 // opposite extreme, a full-speed spin the wrong way for a frame.
 static uint16_t feedback_unorm16(float v, float min, float max)
 {
-	if(!(v > min)) v = min; // also NaN
+	if(v != v) v = 0; // NaN: no motion (as chiaki-ng-core), not the range's end
+	if(v < min) v = min;
 	if(v > max) v = max;
 	return (uint16_t)(0xffff * (v - min) / (max - min));
 }
