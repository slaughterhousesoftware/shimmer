+/* Shimmer: research hook - send any ctrl message (ps5ctl's `ctrl` command). */
+CHIAKI_EXPORT ChiakiErrorCode chiaki_shimmer_ctrl_send(ChiakiSession *session, uint16_t type, const uint8_t *payload, size_t payload_size)
+{
+	return ctrl_message_send(&session->ctrl, type, payload, payload_size);
 }
 
+/* Shimmer: research override of the DualSense capability messages, as hex in
+ * SHIMMER_DS_ENABLE (3 bytes, type 0x13) and SHIMMER_DS_CONNECT (16 bytes, type 0x11). */
+static void shimmer_hex_override(const char *env, uint8_t *buf, size_t len)
+{
+	const char *h = getenv(env);
+	if(!h) return;
+	for(size_t i = 0; i < len && h[2 * i] && h[2 * i + 1]; i++)
+	{
+		unsigned v;
+		if(sscanf(h + 2 * i, "%2x", &v) == 1) buf[i] = (uint8_t)v;
+	}
+}
