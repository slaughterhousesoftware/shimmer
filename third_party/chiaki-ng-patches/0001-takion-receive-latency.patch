+// and bunched with the next. A wired or Wi-Fi LAN reorders far less than this.
+#define TAKION_AV_REORDER_TIMEOUT_US chiaki_shimmer_reorder_timeout_us
 
+// Shimmer: knobs the app sets before a session (declared in its bridging
+// header). The reorder hold above, and debug loss injection: drop this many
+// per mille of video packets on arrival, to exercise the loss path on a
+// clean LAN. 0 = off.
+int chiaki_shimmer_reorder_timeout_us = 4000;
+int chiaki_shimmer_drop_permille = 0;
+
+// Shimmer: audio sub-stream census. Each non-video AV packet carries one tag
+// byte (0x02 = haptics, the rest go to the game audio decoder). Counting the
+// tags seen shows whether the console sends any other audio stream - the
+// controller speaker, say - that would otherwise be decoded as game audio.
+static uint64_t shimmer_audio_tag_counts[256];
+static uint64_t shimmer_audio_tag_last_log_us;
+
 #define TAKION_POSTPONE_PACKETS_SIZE 32
 
+// Shimmer: the kernel receive buffer, apart from the window advertised to the
+// console (a_rwnd, 100 KB - smaller than macOS's own default, ~20 ms at
+// 40 Mbps, which an IDR burst or a stalled thread overflows). PXPlay asks for
+// megabytes too.
+#define TAKION_SOCKET_RCVBUF (4 * 1024 * 1024)
