-#define TAKION_AV_REORDER_TIMEOUT_US 16000 // ~1 frame at 60fps
+// Shimmer: 16 ms held every packet behind a lost one for a whole frame,
+// parity units included, so a frame FEC could already rebuild arrived late
+// and bunched with the next. A wired or Wi-Fi LAN reorders far less than this.
+#define TAKION_AV_REORDER_TIMEOUT_US 4000
 
 #define TAKION_POSTPONE_PACKETS_SIZE 32
 
+// Shimmer: the kernel receive buffer, apart from the window advertised to the
+// console (a_rwnd, 100 KB - smaller than macOS's own default, ~20 ms at
+// 40 Mbps, which an IDR burst or a stalled thread overflows). PXPlay asks for
+// megabytes too.
+#define TAKION_SOCKET_RCVBUF (4 * 1024 * 1024)
+
 #define TAKION_MESSAGE_HEADER_SIZE 0x10
 
 #define TAKION_PACKET_BASE_TYPE_MASK 0xf
@@ -189,6 +199,22 @@
 static void takion_handle_packet_av(ChiakiTakion *takion, uint8_t base_type, uint8_t *buf, size_t buf_size);
 static ChiakiErrorCode takion_read_extra_sock_messages(ChiakiTakion *takion);
 
+// Shimmer: the largest receive buffer the kernel grants, from
+// TAKION_SOCKET_RCVBUF down to the advertised window.
+static int takion_set_rcvbuf(ChiakiTakion *takion)
+{
+	for(int size = TAKION_SOCKET_RCVBUF; size > (int)takion->a_rwnd; size /= 2)
+	{
+		if(setsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&size, sizeof(size)) == 0)
+		{
+			CHIAKI_LOGI(takion->log, "Takion receive buffer %d bytes", size);
+			return 0;
+		}
+	}
+	const int size = takion->a_rwnd;
+	return setsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&size, sizeof(size));
+}
