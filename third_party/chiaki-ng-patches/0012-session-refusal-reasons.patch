diff -ruN a/lib/include/chiaki/session.h b/lib/include/chiaki/session.h
--- a/lib/include/chiaki/session.h
+++ b/lib/include/chiaki/session.h
@@ -107,6 +107,10 @@
 	CHIAKI_QUIT_REASON_STREAM_CONNECTION_REMOTE_DISCONNECTED,
 	CHIAKI_QUIT_REASON_STREAM_CONNECTION_REMOTE_SHUTDOWN, // like REMOTE_DISCONNECTED, but because the server shut down
 	CHIAKI_QUIT_REASON_PSN_REGIST_FAILED,
+	// Shimmer: the console's own reasons for refusing the session request, which
+	// were folded into SESSION_REQUEST_UNKNOWN (and retried as if transient).
+	CHIAKI_QUIT_REASON_SESSION_REQUEST_REGIST_FAILED, // this client's registration is not accepted (any more)
+	CHIAKI_QUIT_REASON_SESSION_REQUEST_INVALID_PSN_ID, // the registered account is not the console's
 } ChiakiQuitReason;
 
 CHIAKI_EXPORT const char *chiaki_quit_reason_string(ChiakiQuitReason reason);
