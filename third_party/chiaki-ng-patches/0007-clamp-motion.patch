diff -ruN a/lib/src/feedback.c b/lib/src/feedback.c
--- a/lib/src/feedback.c
+++ b/lib/src/feedback.c
@@ -18,6 +18,16 @@
 #define ACCEL_MIN -5.0f
 #define ACCEL_MAX 5.0f
 
+// Shimmer: clamped first - past the range (a flick over ~1,700 deg/s, a knock
+// over 5 g) the float->uint16 cast was undefined and on arm64 wrapped to the
+// opposite extreme, a full-speed spin the wrong way for a frame.
+static uint16_t feedback_unorm16(float v, float min, float max)
+{
+	if(!(v > min)) v = min; // also NaN
+	if(v > max) v = max;
+	return (uint16_t)(0xffff * (v - min) / (max - min));
+}
+
 static uint32_t compress_quat(float *q)
 {
 	// very similar idea as https://github.com/jpreiss/quatcompress
@@ -46,22 +56,22 @@
 CHIAKI_EXPORT void chiaki_feedback_state_format_v9(uint8_t *buf, ChiakiFeedbackState *state)
 {
 	buf[0x0] = 0xa0;
-	uint16_t v = (uint16_t)(0xffff * ((float)state->gyro_x - GYRO_MIN) / (GYRO_MAX - GYRO_MIN));
+	uint16_t v = feedback_unorm16(state->gyro_x, GYRO_MIN, GYRO_MAX);
 	buf[0x1] = v;
 	buf[0x2] = v >> 8;
-	v = (uint16_t)(0xffff * ((float)state->gyro_y - GYRO_MIN) / (GYRO_MAX - GYRO_MIN));
+	v = feedback_unorm16(state->gyro_y, GYRO_MIN, GYRO_MAX);
 	buf[0x3] = v;
 	buf[0x4] = v >> 8;
-	v = (uint16_t)(0xffff * ((float)state->gyro_z - GYRO_MIN) / (GYRO_MAX - GYRO_MIN));
+	v = feedback_unorm16(state->gyro_z, GYRO_MIN, GYRO_MAX);
 	buf[0x5] = v;
 	buf[0x6] = v >> 8;
-	v = (uint16_t)(0xffff * ((float)state->accel_x - ACCEL_MIN) / (ACCEL_MAX - ACCEL_MIN));
+	v = feedback_unorm16(state->accel_x, ACCEL_MIN, ACCEL_MAX);
 	buf[0x7] = v;
 	buf[0x8] = v >> 8;
-	v = (uint16_t)(0xffff * ((float)state->accel_y - ACCEL_MIN) / (ACCEL_MAX - ACCEL_MIN));
+	v = feedback_unorm16(state->accel_y, ACCEL_MIN, ACCEL_MAX);
 	buf[0x9] = v;
 	buf[0xa] = v >> 8;
-	v = (uint16_t)(0xffff * ((float)state->accel_z - ACCEL_MIN) / (ACCEL_MAX - ACCEL_MIN));
+	v = feedback_unorm16(state->accel_z, ACCEL_MIN, ACCEL_MAX);
 	buf[0xb] = v;
 	buf[0xc] = v >> 8;
 	float q[4] = { state->orient_x, state->orient_y, state->orient_z, state->orient_w };
