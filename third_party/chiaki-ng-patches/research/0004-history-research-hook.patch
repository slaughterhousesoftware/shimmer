 static void feedback_sender_send_history_packet(ChiakiFeedbackSender *feedback_sender, ChiakiSeqNum16 seq_num, uint8_t event_count, const uint8_t *buf, size_t buf_size)
 {
-	//CHIAKI_LOGD(feedback_sender->log, "Feedback History:");
-	//chiaki_log_hexdump(feedback_sender->log, CHIAKI_LOG_DEBUG, buf, buf_size);
+	if(chiaki_shimmer_history_drop_seq >= 0 && seq_num == (ChiakiSeqNum16)chiaki_shimmer_history_drop_seq)
+	{
+		CHIAKI_LOGI(feedback_sender->log, "History seq %u count %u: dropped (research)", (unsigned)seq_num, (unsigned)event_count);
+		return;
+	}
+	if(chiaki_shimmer_history_log > 0)
+	{
+		chiaki_shimmer_history_log--;
+		char hex[3 * 64 + 1] = { 0 };
+		for(size_t i = 0; i < buf_size && i < 64; i++)
+			snprintf(hex + 3 * i, 4, "%02x ", buf[i]);
+		CHIAKI_LOGI(feedback_sender->log, "History seq %u count %u: %s", (unsigned)seq_num, (unsigned)event_count, hex);
+	}
 	chiaki_takion_send_feedback_history(feedback_sender->takion, seq_num, event_count, (uint8_t *)buf, buf_size);
