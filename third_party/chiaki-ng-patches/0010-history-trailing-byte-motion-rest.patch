-CHIAKI_EXPORT void chiaki_feedback_state_format_v9(uint8_t *buf, ChiakiFeedbackState *state)
+CHIAKI_EXPORT void chiaki_feedback_state_format_v9(uint8_t *buf, ChiakiFeedbackState *state_in)
 {
+	// Shimmer: a sample that isn't finite goes out as rest, as chiaki-ng-core
+	// sends it - no rotation, gravity on Y, the identity orientation - not 0 g
+	// and an undefined float->uint cast in compress_quat.
+	ChiakiFeedbackState rest = *state_in;
+	ChiakiFeedbackState *state = &rest;
+	if(!isfinite(rest.gyro_x)) rest.gyro_x = 0.0f;
+	if(!isfinite(rest.gyro_y)) rest.gyro_y = 0.0f;
+	if(!isfinite(rest.gyro_z)) rest.gyro_z = 0.0f;
+	if(!isfinite(rest.accel_x) || !isfinite(rest.accel_y) || !isfinite(rest.accel_z))
+	{
+		rest.accel_x = 0.0f;
+		rest.accel_y = 1.0f;
+		rest.accel_z = 0.0f;
+	}
+	if(!isfinite(rest.orient_x) || !isfinite(rest.orient_y) || !isfinite(rest.orient_z) || !isfinite(rest.orient_w))
+	{
+		rest.orient_x = 0.0f;
+		rest.orient_y = 0.0f;
+		rest.orient_z = 0.0f;
+		rest.orient_w = 1.0f;
+	}
 	buf[0x0] = 0xa0;
 	uint16_t v = feedback_unorm16(state->gyro_x, GYRO_MIN, GYRO_MAX);
 	buf[0x1] = v;
